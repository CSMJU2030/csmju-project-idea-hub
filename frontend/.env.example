# Backend (NestJS) of this subsystem — next.config.ts passes /api/*, /auth/login,
# /auth/callback and /auth/logout on to it. Use your team's backend port.
BACKEND_URL=http://127.0.0.1:4201

# หน้าเว็บ Core Hub (portal ที่ผู้ใช้ login) — ลิงก์ "กลับ CSMJU Portal" ใน ShowcaseAppShell พาไปที่นี่
# ไม่ตั้ง = ไม่แสดงปุ่ม · ต้องเป็นค่าเดียวกับ CORE_HUB_WEB_URL ของ backend
CORE_HUB_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CORE_HUB_WEB_URL=http://localhost:3000
